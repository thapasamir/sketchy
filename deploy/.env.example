# Copy to /opt/sketchy/.env on the droplet and fill in. Never commit the real file.

# Hostname players use. No domain yet? Use <droplet-ip-with-dashes>.sslip.io,
# e.g. 203.0.113.7 -> 203-0-113-7.sslip.io (free, and Caddy can get a certificate for it).
DOMAIN=203-0-113-7.sslip.io
PHX_HOST=203-0-113-7.sslip.io

# Neon: use the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
POOL_SIZE=5

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Set by the deploy workflow; a fixed value is only for manual runs.
APP_IMAGE=ghcr.io/thapasamir/sketchy:latest
